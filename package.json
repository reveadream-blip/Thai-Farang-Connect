{
  "name": "thai-farang-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy:api": "wrangler deploy -c wrangler.api.toml",
    "pages:build": "opennextjs-cloudflare build --config wrangler.opennext.jsonc && node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "pages:deploy": "npm run pages:build && opennextjs-cloudflare deploy --config wrangler.opennext.jsonc",
    "preview:cf": "npm run pages:build && opennextjs-cloudflare preview --config wrangler.opennext.jsonc"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.8",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-resources-to-backend": "^1.2.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250510.0",
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.90.0"
  }
}
